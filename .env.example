# ==============================================================================
# Vicarius Agent — Environment Variables Specification (.env.example)
# Sourced from PRD_academic_task_agent.md (Section 9)
# NEVER commit actual secrets or production values to version control.
# ==============================================================================

# Google OAuth 2.0 (Shared across Gmail, Classroom, Drive, Tasks, Calendar APIs)
GOOGLE_OAUTH_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com" # Google Cloud OAuth 2.0 Web Client ID
GOOGLE_OAUTH_CLIENT_SECRET="your-google-oauth-client-secret"                   # Google Cloud OAuth 2.0 Client Secret
GOOGLE_OAUTH_REFRESH_TOKEN="your-google-oauth-refresh-token"                   # Offline access refresh token for user account

# Supabase (PostgreSQL & Database Access)
SUPABASE_URL="https://your-project-ref.supabase.co"                            # Supabase project REST/API URL
SUPABASE_SERVICE_KEY="your-supabase-service-role-secret-key"                   # Elevated service role secret for Vercel backend functions
SUPABASE_WORKER_KEY="your-scoped-worker-or-anon-key"                           # Scoped key for local Python worker job-queue access

# AI / LLM Providers
GROQ_API_KEY="gsk_your_groq_api_key"                                           # Fast/low-cost classification & extraction pass
GEMINI_API_KEY="AIzaSy_your_gemini_api_key"                                    # Google AI Studio key for vision/PDF extraction pass
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-key"                             # Fallback provider key for model failover & verification

# Telegram Bot (Notifications, Interactive Clarifications & Control)
TELEGRAM_BOT_TOKEN="123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ"                     # Telegram Bot token generated via @BotFather
TELEGRAM_ALLOWED_CHAT_ID="123456789"                                           # Owner's numeric Telegram chat ID for strict authorization check

# Antigravity CLI Execution Engine
ANTIGRAVITY_PINNED_VERSION="1.1.12"                                             # Exact pinned CLI version checked by worker before runs

# Google Drive Storage
DRIVE_OUTPUT_FOLDER_ID="your_google_drive_folder_id_for_agent_outputs"         # ID of "Agent Outputs" parent folder in Google Drive

# Ingestion & Webhook Security
INGEST_SECRET_TOKEN="your_secure_random_token_for_cron_trigger"                # Secret bearer token checked by /api/ingest trigger

# Runtime Tunables & Policies (PRD Section 9 & micro_upgradeV3)
LIGHT_TIMEOUT_MINUTES=15                                                        # Timeout in minutes for light tasks (document, presentation)
MEDIUM_TIMEOUT_MINUTES=45                                                       # Timeout in minutes for medium tasks (research, code_project)
HEAVY_TIMEOUT_MINUTES=240                                                      # Timeout in minutes for heavy tasks (ml_training, complex builds)
HEAVY_JOB_PROGRESS_INTERVAL_MINUTES=30                                         # Interval for reporting heavy job progress updates via Telegram
HEAVY_JOB_PREFERRED_START="23:00"                                               # Preferred start time for heavy jobs with slack (IST)
HEAVY_JOB_PREFERRED_END="07:00"                                                 # Preferred end time for heavy jobs with slack (IST)
JOB_TIMEOUT_MINUTES=45                                                         # Default execution duration in minutes for subprocess runs
QUESTION_WAIT_TIMEOUT_MINUTES=20                                               # Timeout in minutes waiting for user response via ask_human
REMINDER_HOURS_BEFORE=24                                                       # Threshold in hours for Google Calendar email reminder override
TIMEZONE="Asia/Kolkata"                                                        # Standard timezone for all deadline math and conversions
ARCHIVE_AFTER_DAYS=90                                                          # Days after completion before tasks are flagged as archived
