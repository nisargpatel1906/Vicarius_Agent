# ==============================================================================
# Vicarius Agent — Environment Variables Specification (.env.example)
# Open-Source Self-Hosting Configuration
# NEVER commit actual secrets or production values to version control.
# ==============================================================================

# Access Control & Allow-list (Single-Owner or Team Access)
ALLOWED_EMAILS="your-email@gmail.com"                                              # Comma-separated allow-list of Google accounts allowed to sign in
OWNER_EMAIL="your-email@gmail.com"                                                 # Primary owner email (used by worker daemon to load active profile)
NEXT_PUBLIC_SITE_URL="https://your-deployment.vercel.app"                         # Production URL or http://localhost:3000 for local dev

# Supabase (PostgreSQL, Auth & Row Level Security)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"                   # Public Supabase project URL (safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-public-key"                     # Public Supabase anon key (safe for browser; locked down by RLS)
SUPABASE_URL="https://your-project-ref.supabase.co"                               # Backend Supabase URL
SUPABASE_SERVICE_KEY="your-supabase-service-role-secret-key"                      # Elevated service_role secret for Vercel API routes & migrations
SUPABASE_WORKER_KEY="your-supabase-service-role-secret-key"                       # Secret key for local Python worker daemon

# Google Cloud OAuth 2.0 (Shared across Gmail, Classroom, Drive, Tasks, Calendar)
# Set in Supabase Dashboard -> Auth -> Providers -> Google, and here for local worker
GOOGLE_OAUTH_CLIENT_ID="your-client-id.apps.googleusercontent.com"                # Google Cloud OAuth 2.0 Web Client ID
GOOGLE_OAUTH_CLIENT_SECRET="your-client-secret"                                   # Google Cloud OAuth 2.0 Web Client Secret
# GOOGLE_OAUTH_REFRESH_TOKEN is optional; automatically captured when you sign in via Google!

# AI / LLM Providers (At least one required)
GROQ_API_KEY="your-groq-api-key"                                                   # Fast, low-cost Llama 3.3 classification & extraction
GEMINI_API_KEY="your-gemini-api-key"                                             # Google Gemini 2.5 / 1.5 Pro for multimodal & reasoning
OPENROUTER_API_KEY="your-openrouter-key"                                         # Multi-model fallback provider

# Telegram Bot (Optional: Push alerts, voice commands & mobile delivery)
TELEGRAM_BOT_TOKEN="123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ"                        # Bot token from @BotFather
TELEGRAM_ALLOWED_CHAT_ID=""                                                        # Optional fallback (auto-linked via /start in setup wizard)

# Automation & Security
CRON_SECRET="your_secure_random_cron_secret"                                      # Bearer secret for Vercel Cron jobs (/api/ingest, /api/briefing)
INGEST_SECRET_TOKEN="your_secure_random_ingest_token"                             # Bearer token for automated ingestion triggers
DRIVE_OUTPUT_FOLDER_ID="your_google_drive_folder_id_for_agent_outputs"            # Optional: ID of parent folder in Google Drive

# Runtime Tunables & Policies
TIMEZONE="Asia/Kolkata"                                                           # Default timezone for deadline calculations
LIGHT_TIMEOUT_MINUTES=15
MEDIUM_TIMEOUT_MINUTES=45
HEAVY_TIMEOUT_MINUTES=240
ANTIGRAVITY_PINNED_VERSION="1.1.26"
